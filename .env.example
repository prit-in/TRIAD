# Copy to .env and adjust. .env is git-ignored and must never contain a real secret in a
# shared checkout (PRD section 29.1, NFR-SEC-03).

# --- Ports on the host (chosen to avoid clashing with other local stacks) ---
TRIAD_PG_PORT=55432
TRIAD_API_PORT=8010
TRIAD_WEB_PORT=5173
TRIAD_MLFLOW_PORT=5500
TRIAD_SPARK_UI_PORT=8090

# --- Database ---
POSTGRES_PASSWORD=triad_dev_pw

# --- API ---
TRIAD_JWT_SECRET=change-me-for-any-shared-machine
VITE_API_BASE=http://localhost:8010/api/v1

# --- Spark ---
# local[2] keeps the driver in-process (LR-07). Use spark://spark-master:7077 with
# `make up-spark` for the cluster demo.
SPARK_MASTER_URL=local[2]
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1800m

# --- LLM (ADR-0003) ---
# template_only | recorded | anthropic | openai | ollama
TRIAD_LLM_PROVIDER=template_only
TRIAD_LLM_MODEL_ID=none
# Set the matching key in the environment, never in this file:
#   ANTHROPIC_API_KEY=...   OPENAI_API_KEY=...   TRIAD_LLM_BASE_URL=http://host.docker.internal:11434
