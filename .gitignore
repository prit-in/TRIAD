# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/
frontend/.vite/

# Generated Scala artifacts: produced per run from the templates, never source
scala_spark/jobs/src/main/scala/triad/jobs/generated/

# Scala / sbt
target/
project/target/
project/project/
.bloop/
.metals/
.bsp/

# Project-local toolchains, caches, runtime state (never committed)
.triad/toolchains/
.triad/cache/
.triad/runtime/

# Data: nothing bulky is ever committed
data/
datasets/raw/
datasets/downloads/
datasets/synthetic/out/
!datasets/fixtures/**
mlruns/
mlartifacts/

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Experiment raw outputs (configs are committed, results are not by default)
experiments/*/results/

# Tooling artefacts that are not part of the project
.claude-flow/
.claude/

# Ad-hoc diagnostics live in scripts/; .triad holds only caches and toolchains
.triad/

# The dev server installs into a named volume; the lockfile is what is committed
frontend/node_modules/

# Browser-automation scratch from verifying the dashboard
.playwright-mcp/

# The TypeScript build cache changes on every compile
*.tsbuildinfo

# Faculty source materials: kept on disk, not in the repository. 4_Teams_Titles_Links.pdf lists
# other teams' registration numbers and a personal phone number, and the rest are the faculty's
# own documents; the repository may be published, so none of them are redistributed through it.
# docs/faculty/FACULTY_MATERIALS_ANALYSIS.md carries every requirement they impose.
docs/faculty/source/
